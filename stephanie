    def setup_styles(self):
        """Configure ttk widget styles in one place."""
        style = ttk.Style()
        try:
            style.theme_use("clam")
        except tk.TclError:
            pass

        theme = "light"
        if self.current_user is not None:
            theme = self.current_user.preferences.get("theme", "light")

        if theme == "dark":
            field_bg = "#374151"
            field_fg = "#000000"
            selected_bg = "#93c5fd"
            heading_bg = "#111827"
            heading_fg = "#f9fafb"
            tab_bg = "#1f2937"
            tab_fg = "#f9fafb"
        else:
            field_bg = "#ffffff"
            field_fg = "#1f2937"
            selected_bg = "#dbeafe"
            heading_bg = "#e5e7eb"
            heading_fg = "#1f2937"
            tab_bg = "#f4f7fb"
            tab_fg = "#1f2937"

        style.configure("Planner.TNotebook", background=self.bg_color, borderwidth=0)
        style.configure(
            "Planner.TNotebook.Tab",
            padding=getattr(self, "tab_padding", (16, 8)),
            font=("Arial", 10, "bold"),
            background=tab_bg,
            foreground=tab_fg
        )
        style.map(
            "Planner.TNotebook.Tab",
            background=[("selected", self.card_color)],
            foreground=[("selected", self.text_color)]
        )

        style.configure(
            "Planner.Treeview",
            rowheight=getattr(self, "tree_rowheight", 28),
            font=("Arial", 10),
            background=field_bg,
            foreground=field_fg,
            fieldbackground=field_bg,
            bordercolor=self.card_color,
            lightcolor=self.card_color,
            darkcolor=self.card_color
        )
        style.map(
            "Planner.Treeview",
            background=[("selected", selected_bg)],
            foreground=[("selected", "#000000")]
        )
        style.configure(
            "Planner.Treeview.Heading",
            font=("Arial", 10, "bold"),
            background=heading_bg,
            foreground=heading_fg
        )

        style.configure(
            "Planner.TCombobox",
            padding=4,
            fieldbackground=field_bg,
            background=field_bg,
            foreground=field_fg,
            arrowcolor=field_fg
        )

    def apply_theme(self):
        """Apply light or dark colors based on the logged-in user's preference."""
        if self.current_user is None:
            return

        theme = self.current_user.preferences.get("theme", "light")

        if theme == "dark":
            self.bg_color = "#111827"
            self.card_color = "#1f2937"
            self.accent_color = "#2563eb"
            self.text_color = "#f9fafb"
        else:
            self.bg_color = "#f4f7fb"
            self.card_color = "#ffffff"
            self.accent_color = "#2f6fed"
            self.text_color = "#1f2937"

        self.pad_x = 8
        self.pad_y = 10
        self.card_pad = 14
        self.tree_rowheight = 28
        self.tab_padding = (16, 8)

        self.root.configure(bg=self.bg_color)
        self.main_frame.configure(bg=self.bg_color)
        self.setup_styles()

    def get_muted_text_color(self):
        """Return secondary text color for the active theme."""
        if self.current_user is not None and self.current_user.preferences.get("theme", "light") == "dark":
            return "#d1d5db"
        return "#4b5563"

    def style_entry(self, entry):
        """Apply theme colors to standard Tk Entry widgets."""
        if self.current_user is not None and self.current_user.preferences.get("theme", "light") == "dark":
            entry.configure(bg="#374151", fg="#f9fafb", insertbackground="#f9fafb")
        else:
            entry.configure(bg="#ffffff", fg="#1f2937", insertbackground="#1f2937")

    def style_all_widgets(self, parent):
        """Recursively apply dark/light colors to regular Tk widgets only."""
        theme = "light"
        if self.current_user is not None:
            theme = self.current_user.preferences.get("theme", "light")

        muted = self.get_muted_text_color()
        entry_bg = "#374151" if theme == "dark" else "#ffffff"
        entry_fg = "#f9fafb" if theme == "dark" else "#1f2937"

        try:
            children = parent.winfo_children()
        except tk.TclError:
            return

        for widget in children:
            if isinstance(widget, tk.Frame):
                try:
                    current_bg = widget.cget("bg")
                    if current_bg in ("#f4f7fb", "#111827"):
                        widget.configure(bg=self.bg_color)
                    else:
                        widget.configure(bg=self.card_color)
                except tk.TclError:
                    pass

            elif isinstance(widget, tk.Label):
                try:
                    current_text = widget.cget("text")
                    current_bg = widget.cget("bg")

                    # Do not overwrite the colored calendar labels or legend colors.
                    calendar_colors = ("#3b82f6", "#f59e0b", "#10b981")
                    if current_bg in calendar_colors:
                        pass
                    else:
                        if current_bg in ("#f4f7fb", "#111827"):
                            widget.configure(bg=self.bg_color)
                        else:
                            widget.configure(bg=self.card_color)

                        if current_text and (
                            "Customize" in current_text
                            or "Theme changes" in current_text
                            or "Username format" in current_text
                            or "Log in" in current_text
                        ):
                            widget.configure(fg=muted)
                        else:
                            widget.configure(fg=self.text_color)
                except tk.TclError:
                    pass

            elif isinstance(widget, tk.Entry):
                try:
                    widget.configure(bg=entry_bg, fg=entry_fg, insertbackground=entry_fg)
                except tk.TclError:
                    pass

            elif isinstance(widget, tk.Listbox):
                try:
                    widget.configure(bg=entry_bg, fg=entry_fg)
                except tk.TclError:
                    pass

            elif isinstance(widget, tk.Button):
                try:
                    if widget.cget("bg") in ("#2f6fed", "#2563eb"):
                        widget.configure(bg=self.accent_color, fg="white")
                except tk.TclError:
                    pass

            self.style_all_widgets(widget)

    def clear_main_frame(self):
        """Remove the current screen before drawing the next one."""
        for widget in self.main_frame.winfo_children():
            widget.destroy()

    def make_card(self, parent, title=None):
