    def show_day_items_popup(self, day_num, calendar_items):
        """Open a small scrollable popup showing all items for a day."""
        popup = tk.Toplevel(self.root)
        popup.title("Day Details")
        popup.geometry("460x380")
        popup.configure(bg=self.card_color)

        title_text = f"{calendar.month_name[self.calendar_month]} {day_num}, {self.calendar_year}"
        tk.Label(
            popup,
            text=title_text,
            font=("Arial", 14, "bold"),
            bg=self.card_color,
            fg=self.text_color
        ).pack(anchor="w", padx=12, pady=(12, 6))

        container = tk.Frame(popup, bg=self.card_color)
        container.pack(fill="both", expand=True, padx=12, pady=(0, 12))

        canvas = tk.Canvas(container, bg=self.card_color, highlightthickness=0)
        canvas.pack(side="left", fill="both", expand=True)

        scrollbar = ttk.Scrollbar(container, orient="vertical", command=canvas.yview)
        scrollbar.pack(side="right", fill="y")

        canvas.configure(yscrollcommand=scrollbar.set)

        inner = tk.Frame(canvas, bg=self.card_color)
        window = canvas.create_window((0, 0), window=inner, anchor="nw")

        def update_scroll(event=None):
            canvas.configure(scrollregion=canvas.bbox("all"))
            canvas.itemconfig(window, width=canvas.winfo_width())

        inner.bind("<Configure>", update_scroll)
        canvas.bind("<Configure>", update_scroll)

        def on_mousewheel(event):
            canvas.yview_scroll(int(-1 * (event.delta / 120)), "units")
            return "break"

        canvas.bind("<MouseWheel>", on_mousewheel)
        inner.bind("<MouseWheel>", on_mousewheel)

        if not calendar_items:
            tk.Label(
                inner,
                text="No items for this day.",
                font=("Arial", 10, "italic"),
                bg=self.card_color,
                fg=self.get_muted_text_color()
            ).pack(anchor="w", pady=8)
        else:
            for item_bg, item_text in calendar_items:
                item = tk.Label(
                    inner,
                    text=item_text,
                    font=("Arial", 10),
                    bg=item_bg,
                    fg="white",
                    anchor="w",
                    justify="left",
                    padx=8,
                    pady=5,
                    wraplength=270
                )
                item.pack(fill="x", anchor="w", pady=4)
                item.bind("<MouseWheel>", on_mousewheel)

        tk.Button(
            popup,
            text="Close",
            width=12,
            command=popup.destroy
        ).pack(pady=(0, 12))

    def add_event(self):
        title = self.event_title_entry.get().strip()
        date = self.event_date_entry.get().strip()
        time = self.event_time_entry.get().strip()
        ampm = self.event_ampm_var.get()
        location = self.event_location_entry.get().strip()

        if not title:
            messagebox.showerror("Event Error", "Event title cannot be empty.")
            return

        if not self.validate_due_date(date):
            messagebox.showerror("Event Error", "Event date must use MM-DD-YY format.")
            return

        if not time:
            messagebox.showerror("Event Error", "Event time cannot be empty.")
            return

        event = {"title": title, "date": date, "time": f"{time} {ampm}", "location": location}
        self.current_user.events.append(event)
        self.storage.save_data()

        self.event_title_entry.delete(0, tk.END)
        self.event_date_entry.delete(0, tk.END)
        self.event_time_entry.delete(0, tk.END)
        self.event_location_entry.delete(0, tk.END)
        self.event_ampm_var.set("AM")
        self.refresh_events_list()

    def refresh_events_list(self):
        if hasattr(self, "events_tree"):
            try:
                if self.events_tree.winfo_exists():
                    for item in self.events_tree.get_children():
                        self.events_tree.delete(item)

                    for index, event in enumerate(self.current_user.events):
                        self.events_tree.insert(
                            "",
                            "end",
                            iid=str(index),
                            values=(
                                event.get("title", ""),
                                event.get("date", ""),
                                event.get("time", ""),
                                event.get("location", ""),
                            ),
                        )
            except tk.TclError:
                pass

        self.refresh_calendar_if_ready()

    def delete_selected_event(self):
        selected = self.events_tree.selection()
        if not selected:
            messagebox.showerror("Delete Error", "Please select an event to delete.")
            return

        index = int(selected[0])
        event = self.current_user.events[index]
        confirm = messagebox.askyesno("Confirm Delete", f"Delete event '{event.get('title', '')}'?")

        if confirm:
            del self.current_user.events[index]
            self.storage.save_data()
            self.refresh_events_list()

    def edit_selected_event(self):
        selected = self.events_tree.selection()
        if not selected:
            messagebox.showerror("Edit Error", "Please select an event to edit.")
            return

        index = int(selected[0])
        event = self.current_user.events[index]

        popup = tk.Toplevel(self.root)
        popup.title("Edit Event")
        popup.geometry("360x330")
        popup.configure(bg=self.card_color)

        tk.Label(popup, text="Edit Event", font=("Arial", 12, "bold"), bg=self.card_color, fg=self.text_color).pack(pady=(10, 10))

        tk.Label(popup, text="Title", bg=self.card_color, fg=self.text_color).pack(anchor="w", padx=12)
        title_entry = tk.Entry(popup, width=32)
        title_entry.insert(0, event.get("title", ""))
        title_entry.pack(padx=12, pady=(0, 8))

        tk.Label(popup, text="Date (MM-DD-YY)", bg=self.card_color, fg=self.text_color).pack(anchor="w", padx=12)
        date_entry = tk.Entry(popup, width=32)
        date_entry.insert(0, event.get("date", ""))
        date_entry.pack(padx=12, pady=(0, 8))

        tk.Label(popup, text="Time", bg=self.card_color, fg=self.text_color).pack(anchor="w", padx=12)
        time_entry = tk.Entry(popup, width=32)
        time_entry.insert(0, event.get("time", ""))
        time_entry.pack(padx=12, pady=(0, 8))

        tk.Label(popup, text="Location", bg=self.card_color, fg=self.text_color).pack(anchor="w", padx=12)
        location_entry = tk.Entry(popup, width=32)
        location_entry.insert(0, event.get("location", ""))
        location_entry.pack(padx=12, pady=(0, 12))

        def save_changes():
            if not title_entry.get().strip():
                messagebox.showerror("Edit Error", "Event title cannot be empty.")
                return

            if not self.validate_due_date(date_entry.get().strip()):
                messagebox.showerror("Edit Error", "Event date must use MM-DD-YY format.")
                return

            event["title"] = title_entry.get().strip()
            event["date"] = date_entry.get().strip()
            event["time"] = time_entry.get().strip()
            event["location"] = location_entry.get().strip()
            self.storage.save_data()
            self.refresh_events_list()
            popup.destroy()

        tk.Button(popup, text="Save Changes", bg=self.accent_color, fg="white", width=14, command=save_changes).pack(pady=10)
        self.style_all_widgets(popup)

