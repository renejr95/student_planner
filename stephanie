    def build_calendar_grid(self, parent):
        """Show saved events in a larger month calendar with readable boxes."""
        for widget in parent.winfo_children()[1:]:
            widget.destroy()

        today = datetime.today()
        target_month = today.month
        target_year = today.year

        event_dates = []
        for event in self.current_user.events:
            try:
                event_dates.append(datetime.strptime(event.get("date", ""), "%m-%d-%y"))
            except ValueError:
                pass

        if event_dates and not any(d.month == target_month and d.year == target_year for d in event_dates):
            first_event = sorted(event_dates)[0]
            target_month = first_event.month
            target_year = first_event.year

        top_row = tk.Frame(parent, bg=self.card_color)
        top_row.pack(fill="x", pady=(0, 10))

        month_title = f"{calendar.month_name[target_month]} {target_year}"
        tk.Label(
            top_row,
            text=month_title,
            font=("Arial", 16, "bold"),
            bg=self.card_color,
            fg=self.text_color,
        ).pack(side="left")

        tk.Label(
            top_row,
            text="Events appear inside the day boxes.",
            font=("Arial", 10),
            bg=self.card_color,
            fg="#6b7280" if self.current_user.preferences.get("theme", "light") == "light" else "#d1d5db",
        ).pack(side="left", padx=(14, 0))

        grid_frame = tk.Frame(parent, bg=self.card_color)
        grid_frame.pack(fill="both", expand=True)

        days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
        for col, day in enumerate(days):
            grid_frame.columnconfigure(col, weight=1, uniform="calendar")
            tk.Label(
                grid_frame,
                text=day,
                font=("Arial", 11, "bold"),
                bg=self.card_color,
                fg=self.text_color,
                anchor="center",
            ).grid(row=0, column=col, sticky="nsew", padx=3, pady=(0, 4))

        events_by_day = {}
        for event in self.current_user.events:
            try:
                event_date = datetime.strptime(event.get("date", ""), "%m-%d-%y")
            except ValueError:
                continue

            if event_date.month == target_month and event_date.year == target_year:
                events_by_day.setdefault(event_date.day, []).append(event)

        month_weeks = calendar.Calendar(firstweekday=6).monthdayscalendar(target_year, target_month)
        normal_cell_bg = "#ffffff" if self.current_user.preferences.get("theme", "light") == "light" else "#374151"
        muted_cell_bg = "#f3f4f6" if self.current_user.preferences.get("theme", "light") == "light" else "#1f2937"
        event_bg = "#eef4ff" if self.current_user.preferences.get("theme", "light") == "light" else "#111827"
        event_fg = "#1f2937" if self.current_user.preferences.get("theme", "light") == "light" else "#f9fafb"

        # Always show exactly 6 calendar rows so the full month is visible.
        while len(month_weeks) < 6:
            month_weeks.append([0, 0, 0, 0, 0, 0, 0])

        for row in range(1, 7):
            grid_frame.rowconfigure(row, weight=1, uniform="calendar_rows", minsize=74)

        for row, week in enumerate(month_weeks[:6], start=1):
            for col, day_num in enumerate(week):
                cell_bg = muted_cell_bg if day_num == 0 else normal_cell_bg

                cell = tk.Frame(
                    grid_frame,
                    bg=cell_bg,
                    bd=1,
                    relief="solid",
                    padx=5,
                    pady=4
                )
                cell.grid(row=row, column=col, sticky="nsew", padx=3, pady=3)
                cell.grid_propagate(False)

                if day_num == 0:
                    continue

                tk.Label(
                    cell,
                    text=str(day_num),
                    font=("Arial", 9, "bold"),
                    bg=cell_bg,
                    fg=self.text_color,
                ).pack(anchor="nw")

                day_events = events_by_day.get(day_num, [])
                for event in day_events[:2]:
                    event_label = tk.Label(
                        cell,
                        text=f"{event.get('time', '')}  {event.get('title', '')}",
                        font=("Arial", 8),
                        bg=event_bg,
                        fg=event_fg,
                        anchor="w",
                        justify="left",
                        wraplength=130,
                        padx=4,
                        pady=1,
                    )
                    event_label.pack(fill="x", anchor="w", pady=(2, 0))

                if len(day_events) > 2:
                    tk.Label(
                        cell,
                        text=f"+ {len(day_events) - 2} more",
                        font=("Arial", 8, "italic"),
                        bg=cell_bg,
                        fg=self.text_color,
                    ).pack(anchor="w", pady=(2, 0))

    def add_event(self):
        title = self.event_title_entry.get().strip()
        date = self.event_date_entry.get().strip()
        time = self.event_time_entry.get().strip()
        ampm = self.event_ampm_var.get()
        location = self.event_location_entry.get().strip()

