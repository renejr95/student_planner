            "Layout chooses whether the app opens to Events or Calendar first."
        )
        tk.Label(
            card,
            text=note,
            font=("Arial", 10, "italic"),
            bg=self.card_color,
            fg="#6b7280" if self.current_user.preferences.get("theme", "light") == "light" else "#d1d5db",
            wraplength=800,
            justify="left",
        ).pack(anchor="w")

    def save_preferences(self):
        self.current_user.preferences["theme"] = self.theme_var.get()
        self.current_user.preferences["layout"] = self.layout_var.get()
        self.current_user.preferences["density"] = self.density_var.get()
        self.storage.save_data()
        messagebox.showinfo("Success", "Preferences updated.")
        self.show_dashboard()


if __name__ == "__main__":
    root = tk.Tk()
    app = StudentPlannerGUI(root)
    root.mainloop()
