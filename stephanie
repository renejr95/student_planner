        self.build_calendar_grid(self.calendar_card)

    def shift_calendar_month(self, amount):
        """Move the calendar view backward or forward by one month."""
        if self.calendar_month is None or self.calendar_year is None:
            today = datetime.today()
            self.calendar_month = today.month
            self.calendar_year = today.year

        self.calendar_month += amount

        if self.calendar_month < 1:
            self.calendar_month = 12
            self.calendar_year -= 1
        elif self.calendar_month > 12:
            self.calendar_month = 1
            self.calendar_year += 1

        self.selected_calendar_day = None
        self.build_calendar_grid(self.calendar_card)

    def select_calendar_day(self, day_num):
        """Store the selected day and refresh the calendar/details panel."""
        self.selected_calendar_day = day_num
        self.build_calendar_grid(self.calendar_card)

    def refresh_calendar_if_ready(self):
        """Refresh calendar safely only when the calendar frame still exists."""
        if hasattr(self, "calendar_card"):
            try:
                if self.calendar_card.winfo_exists():
                    self.build_calendar_grid(self.calendar_card)
            except tk.TclError:
                pass

    def build_calendar_grid(self, parent):
        """Show tasks, events, and reminders in a readable calendar grid."""
        try:
            for widget in parent.winfo_children():
                widget.destroy()
        except tk.TclError:
            return

        today = datetime.today()

        if self.calendar_month is None:
            self.calendar_month = today.month
        if self.calendar_year is None:
            self.calendar_year = today.year

        target_month = self.calendar_month
        target_year = self.calendar_year

        normal_cell_bg = "#ffffff" if self.current_user.preferences.get("theme", "light") == "light" else "#374151"
        muted_cell_bg = "#f3f4f6" if self.current_user.preferences.get("theme", "light") == "light" else "#1f2937"
        selected_bg = "#dbeafe" if self.current_user.preferences.get("theme", "light") == "light" else "#1e3a8a"
        today_bg = "#eff6ff" if self.current_user.preferences.get("theme", "light") == "light" else "#0f172a"

        event_bg = "#3b82f6"
        reminder_bg = "#f59e0b"
        task_bg = "#10b981"
        item_fg = "white"

        top_row = tk.Frame(parent, bg=self.card_color)
        top_row.pack(fill="x", pady=(0, 2))

        tk.Button(
            top_row,
            text="◀ Previous",
            font=("Arial", 10, "bold"),
            command=lambda: self.shift_calendar_month(-1)
        ).pack(side="left")

        month_title = f"{calendar.month_name[target_month]} {target_year}"
        tk.Label(
            top_row,
            text=month_title,
            font=("Arial", 16, "bold"),
            bg=self.card_color,
            fg=self.text_color,
        ).pack(side="left", padx=18)

        tk.Button(
            top_row,
            text="Next ▶",
            font=("Arial", 10, "bold"),
            command=lambda: self.shift_calendar_month(1)
        ).pack(side="left")

        legend_frame = tk.Frame(top_row, bg=self.card_color)
        legend_frame.pack(side="right", padx=(0, 8))

        def legend_item(color, label):
            item = tk.Frame(legend_frame, bg=self.card_color)
            item.pack(side="left", padx=8)

            tk.Label(
                item,
                bg=color,
                width=3,
                height=1,
                bd=1,
                relief="solid"
            ).pack(side="left", padx=(0, 4))

            tk.Label(
                item,
                text=label,
                font=("Arial", 7, "bold"),
                bg=self.card_color,
                fg=self.text_color
            ).pack(side="left")

        legend_item(event_bg, "Events")
        legend_item(reminder_bg, "Reminders")
        legend_item(task_bg, "Tasks")

        events_by_day = {}
        reminders_by_day = {}
        tasks_by_day = {}

        for event in self.current_user.events:
            try:
                event_date = datetime.strptime(event.get("date", ""), "%m-%d-%y")
            except ValueError:
                continue

            if event_date.month == target_month and event_date.year == target_year:
                events_by_day.setdefault(event_date.day, []).append(event)

        for reminder in self.current_user.reminders:
            try:
                reminder_date = datetime.strptime(reminder.get("date", ""), "%m-%d-%y")
            except ValueError:
                continue

            if reminder_date.month == target_month and reminder_date.year == target_year:
                reminders_by_day.setdefault(reminder_date.day, []).append(reminder)

        for task in self.current_user.tasks:
            task_due_date = getattr(task, "due_date", "")

            if not task_due_date and isinstance(task, dict):
                task_due_date = task.get("due_date", task.get("date", ""))

            try:
                task_date = datetime.strptime(task_due_date, "%m-%d-%y")
            except (ValueError, TypeError):
                continue

            if task_date.month == target_month and task_date.year == target_year:
                tasks_by_day.setdefault(task_date.day, []).append(task)

        calendar_area = tk.Frame(parent, bg=self.card_color)
        calendar_area.pack(fill="both", expand=True)

        grid_frame = tk.Frame(calendar_area, bg=self.card_color)
        grid_frame.pack(side="left", fill="both", expand=True)

        details_card = tk.Frame(calendar_area, bg=self.card_color, bd=1, relief="solid", padx=10, pady=10)
        details_card.pack(side="right", fill="y", padx=(12, 0))
        details_card.configure(width=300)
        details_card.pack_propagate(False)

        days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]

        for col, day in enumerate(days):
            grid_frame.columnconfigure(col, weight=1, uniform="calendar")
            tk.Label(
                grid_frame,
                text=day,
                font=("Arial", 7, "bold"),
                bg=self.card_color,
                fg=self.text_color,
                anchor="center",
            ).grid(row=0, column=col, sticky="nsew", padx=2, pady=(0, 1))

        month_weeks = calendar.Calendar(firstweekday=6).monthdayscalendar(target_year, target_month)

        for row in range(1, len(month_weeks) + 1):
            grid_frame.rowconfigure(row, weight=1)

        for row, week in enumerate(month_weeks, start=1):
            for col, day_num in enumerate(week):
                if day_num == 0:
                    cell_bg = muted_cell_bg
                elif self.selected_calendar_day == day_num:
                    cell_bg = selected_bg
                elif today.day == day_num and today.month == target_month and today.year == target_year:
                    cell_bg = today_bg
                else:
                    cell_bg = normal_cell_bg

                cell = tk.Frame(
                    grid_frame,
                    bg=cell_bg,
                    bd=2 if (today.day == day_num and today.month == target_month and today.year == target_year) else 1,
                    relief="solid",
                    padx=4,
                    pady=2
                )
                cell.grid(row=row, column=col, sticky="nsew", padx=2, pady=2)
                cell.grid_propagate(False)

                if day_num == 0:
                    continue

                day_button = tk.Label(
                    cell,
                    text=str(day_num),
                    font=("Arial", 7, "bold"),
                    bg=cell_bg,
                    fg=self.text_color,
                    cursor="hand2"
                )
                day_button.pack(anchor="nw")
                day_button.bind("<Button-1>", lambda event, d=day_num: self.select_calendar_day(d))
                cell.bind("<Button-1>", lambda event, d=day_num: self.select_calendar_day(d))

                calendar_items = []

                for event in events_by_day.get(day_num, []):
                    calendar_items.append((
                        event_bg,
                        f"{event.get('time', '')}  {event.get('title', '')}"
                    ))

                for reminder in reminders_by_day.get(day_num, []):
                    calendar_items.append((
                        reminder_bg,
                        f"{reminder.get('time', '')}  {reminder.get('title', '')}"
                    ))

                for task in tasks_by_day.get(day_num, []):
                    task_title = getattr(task, "title", "")

                    if not task_title and isinstance(task, dict):
                        task_title = task.get("title", "")

                    calendar_items.append((
                        task_bg,
                        f"{task_title}"
                    ))

                # Dot-style calendar display: dots show item types without crowding the box.
                if calendar_items:
                    dot_row = tk.Frame(cell, bg=cell_bg)
                    dot_row.pack(anchor="center", pady=(2, 0))

                    for item_bg, item_text in calendar_items[:10]:
                        dot = tk.Canvas(
                            dot_row,
                            width=7,
