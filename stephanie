    def check_reminders(self):
        if self.current_user is not None:
            now = datetime.now()

            for reminder in self.current_user.reminders:
                if not reminder.get("notify", True):
                    continue

                reminder_string = f"{reminder.get('date', '')} {reminder.get('time', '')}"

                try:
                    reminder_datetime = datetime.strptime(reminder_string, "%m-%d-%y %I:%M %p")
                except ValueError:
                    continue

                if now >= reminder_datetime:
                    messagebox.showinfo("Reminder", f"Reminder: {reminder.get('title', '')}")
                    reminder["notify"] = False
                    self.storage.save_data()

                    if hasattr(self, "reminders_tree"):
                        self.refresh_reminders_list()

        self.root.after(5000, self.check_reminders)

