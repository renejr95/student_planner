    def add_reminder(self):
        title = self.reminder_title_entry.get().strip()
        date = self.reminder_date_entry.get().strip()
        time = self.reminder_time_entry.get().strip()
        ampm = self.reminder_ampm_var.get()

        if not title:
            messagebox.showerror("Reminder Error", "Reminder title cannot be empty.")
            return

        if not self.validate_due_date(date):
            messagebox.showerror("Reminder Error", "Reminder date must use MM-DD-YY format.")
            return

        if not time:
            messagebox.showerror("Reminder Error", "Reminder time cannot be empty.")
            return

        reminder = {"title": title, "date": date, "time": f"{time} {ampm}", "notify": True}
        self.current_user.reminders.append(reminder)
        self.storage.save_data()

        self.reminder_title_entry.delete(0, tk.END)
        self.reminder_date_entry.delete(0, tk.END)
        self.reminder_time_entry.delete(0, tk.END)
        self.reminder_ampm_var.set("AM")
        self.refresh_reminders_list()
        self.refresh_calendar_if_ready()

    def refresh_reminders_list(self):
        if not hasattr(self, "reminders_tree"):
            return

        try:
            if not self.reminders_tree.winfo_exists():
                return

            for item in self.reminders_tree.get_children():
                self.reminders_tree.delete(item)

            for index, reminder in enumerate(self.current_user.reminders):
                status = "Active" if reminder.get("notify", True) else "Notified"
                self.reminders_tree.insert("", "end", iid=str(index), values=(reminder.get("title", ""), reminder.get("date", ""), reminder.get("time", ""), status))
        except tk.TclError:
            pass

    def delete_selected_reminder(self):
        selected = self.reminders_tree.selection()
        if not selected:
            messagebox.showerror("Delete Error", "Please select a reminder to delete.")
            return

        index = int(selected[0])
        del self.current_user.reminders[index]
        self.storage.save_data()
        self.refresh_reminders_list()
        self.refresh_calendar_if_ready()

    def check_reminders(self):
        if self.current_user is not None:
            now = datetime.now()

            for reminder in self.current_user.reminders:
                if not reminder.get("notify", True):
                    continue

                reminder_string = f"{reminder.get('date', '')} {reminder.get('time', '')}"

                try:
                    reminder_datetime = datetime.strptime(reminder_string, "%m-%d-%y %I:%M %p")
                except ValueError:
                    continue

                if now >= reminder_datetime:
                    # Bring app to front even if minimized
                    try:
                        self.root.deiconify()  # restore if minimized
                        self.root.lift()  # bring to front
                        self.root.attributes("-topmost", True)
                        self.root.after(1000, lambda: self.root.attributes("-topmost", False))
                    except:
                        pass

                    messagebox.showinfo("Reminder", f"Reminder: {reminder.get('title', '')}")
                    reminder["notify"] = False
                    self.storage.save_data()

                    if hasattr(self, "reminders_tree"):
                        self.refresh_reminders_list()

        self.root.after(5000, self.check_reminders)

